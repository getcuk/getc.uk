# JDoodle Compiler API (server-only — never expose these to the browser)
# Get Client ID + Secret: https://www.jdoodle.com/compiler-api
JDOODLE_CLIENT_ID=your_client_id_here
JDOODLE_CLIENT_SECRET=your_client_secret_here
JDOODLE_API_URL=https://api.jdoodle.com/v1/execute
# C defaults (GCC 5.3.0). Newer GCC: try versionIndex 4–7
# JDOODLE_LANGUAGE=c
# JDOODLE_VERSION_INDEX=0

# Giscus lesson comments (public — from https://giscus.app after enabling Discussions)
# 1. Enable Discussions on the repo
# 2. Install https://github.com/apps/giscus
# 3. Copy values from https://giscus.app
NEXT_PUBLIC_GISCUS_REPO=owner/repo
NEXT_PUBLIC_GISCUS_REPO_ID=R_...
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_...
